From: Biquaternions <biquaternions@serlith.net>
Date: Tue, 11 Aug 2026 15:12:13 -0500
Subject: [PATCH] Add Configurable Legacy Knockback


diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 64ad2e736ab1c4123d9a8e4bd56222e3e7ea3da8..ede7a31556b0cdda6eb0ee4624f8f0005cc617eb 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -2067,11 +2067,25 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
     }
 
     public void knockback(double power, double xd, double zd, final DamageSource source, final float damage, final boolean comesFromEffect, @Nullable Entity attacker, io.papermc.paper.event.entity.EntityKnockbackEvent.Cause eventCause) { // Paper - knockback events
-        power *= 1.0 - this.getAttributeValue(Attributes.KNOCKBACK_RESISTANCE);
+        power = (2.0 + this.getAttributeValue(Attributes.KNOCKBACK_RESISTANCE)) / 3.0; // Nitrogen - Turn resistance scale back into chance
         if (true || !(power <= 0.0)) { // CraftBukkit - Call event even when force is 0
             // this.needsSync = true; // Paper - moved down
             Vec3 deltaMovement = this.getDeltaMovement();
 
+            // Nitrogen start - Legacy configurable knockback
+            double magnitude = Math.sqrt(xd * xd + zd * zd);
+            Vec3 motion = deltaMovement
+                .scale(me.biquaternions.nitrogen.NitrogenConfig.KNOCKBACK.FRICTION)
+                .add(
+                    -(xd / magnitude * me.biquaternions.nitrogen.NitrogenConfig.KNOCKBACK.HORIZONTAL),
+                    me.biquaternions.nitrogen.NitrogenConfig.KNOCKBACK.VERTICAL,
+                    -(zd / magnitude * me.biquaternions.nitrogen.NitrogenConfig.KNOCKBACK.HORIZONTAL)
+                );
+            if (motion.y() > me.biquaternions.nitrogen.NitrogenConfig.KNOCKBACK.VERTICAL_LIMIT) {
+                motion = new Vec3(motion.x(), me.biquaternions.nitrogen.NitrogenConfig.KNOCKBACK.VERTICAL_LIMIT, motion.z());
+            }
+            if (false) {
+            // Nitrogen end - Legacy configurable knockback
             while (xd * xd + zd * zd < 1.0E-5F) {
                 xd = (this.random.nextDouble() - this.random.nextDouble()) * 0.01;
                 zd = (this.random.nextDouble() - this.random.nextDouble()) * 0.01;
@@ -2083,8 +2097,9 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
                 this.onGround() ? Math.min(0.4, deltaMovement.y / 2.0 + power) : deltaMovement.y,
                 deltaMovement.z / 2.0 - deltaVector.z
             );
+            } // Nitrogen
             // Paper start - knockback events
-            Vec3 knockback = targetMovement.subtract(deltaMovement);
+            Vec3 knockback = motion.subtract(deltaMovement); // Nitrogen - Legacy configurable knockback
             io.papermc.paper.event.entity.EntityKnockbackEvent event = CraftEventFactory.callEntityKnockbackEvent((org.bukkit.craftbukkit.entity.CraftLivingEntity) this.getBukkitEntity(), attacker, attacker, eventCause, power, knockback);
             if (event.isCancelled()) {
                 return;
diff --git a/net/minecraft/world/entity/ai/attributes/Attributes.java b/net/minecraft/world/entity/ai/attributes/Attributes.java
index 54a8384f1bc805865e81aeebcf1eadc89d097c91..0c67f8adb19f4f9b3c6c388b59ad27ec30bfa12e 100644
--- a/net/minecraft/world/entity/ai/attributes/Attributes.java
