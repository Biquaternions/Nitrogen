@@ -59,7 +59,7 @@ public class Attributes {
         "jump_strength", new RangedAttribute("attribute.name.jump_strength", 0.42F, 0.0, 32.0).setSyncable(true)
     );
     public static final Holder<Attribute> KNOCKBACK_RESISTANCE = register(
-        "knockback_resistance", new RangedAttribute("attribute.name.knockback_resistance", 0.0, -2.0, 1.0)
+        "knockback_resistance", new RangedAttribute("attribute.name.knockback_resistance", 0.0, -2.0, 1.0) // Nitrogen - Can't change 'minValue' without breaking something
     );
     public static final Holder<Attribute> LUCK = register("luck", new RangedAttribute("attribute.name.luck", 0.0, -1024.0, 1024.0).setSyncable(true));
     public static final Holder<Attribute> MAX_ABSORPTION = register(
diff --git a/net/minecraft/world/entity/player/Player.java b/net/minecraft/world/entity/player/Player.java
index 2a71a2fa949b3a7fb8ff2c44ec3a3d8636237142..c991cfdc1a532111d4607623dfd023bed31f3731 100644
--- a/net/minecraft/world/entity/player/Player.java
+++ b/net/minecraft/world/entity/player/Player.java
@@ -1211,6 +1211,16 @@ public abstract class Player extends Avatar implements ContainerUser {
         final boolean comesFromEffect
     ) {
         if (knockbackAmount > 0.0F) {
+            // Nitrogen start - Legacy configurable knockback
+            Vec3 motion = entity.getDeltaMovement()
+                .add(
+                    -(Mth.sin(this.getYRot() * Mth.DEG_TO_RAD) * knockbackAmount * me.biquaternions.nitrogen.NitrogenConfig.KNOCKBACK.EXTRA_HORIZONTAL),
+                    me.biquaternions.nitrogen.NitrogenConfig.KNOCKBACK.EXTRA_VERTICAL,
+                    Mth.cos(this.getYRot() * Mth.DEG_TO_RAD) * knockbackAmount * me.biquaternions.nitrogen.NitrogenConfig.KNOCKBACK.EXTRA_HORIZONTAL
+                );
+            entity.needsSync = true;
+            if (false) {
+            // Nitrogen end - Legacy configurable knockback
             if (entity instanceof LivingEntity livingTarget) {
                 livingTarget.knockback(
                     knockbackAmount, Mth.sin(this.getYRot() * Mth.DEG_TO_RAD), -Mth.cos(this.getYRot() * Mth.DEG_TO_RAD), damageSource, damage, comesFromEffect, this, io.papermc.paper.event.entity.EntityKnockbackEvent.Cause.ENTITY_ATTACK // Paper - knockback events
@@ -1218,8 +1228,9 @@ public abstract class Player extends Avatar implements ContainerUser {
             } else {
                 entity.push(-Mth.sin(this.getYRot() * Mth.DEG_TO_RAD) * knockbackAmount, 0.1, Mth.cos(this.getYRot() * Mth.DEG_TO_RAD) * knockbackAmount, this); // Paper - Add EntityKnockbackByEntityEvent and EntityPushedByEntityAttackEvent
             }
+            } // Nitrogen
 
-            this.setDeltaMovement(this.getDeltaMovement().multiply(0.6, 1.0, 0.6));
+            this.setDeltaMovement(motion.multiply(0.6, 1.0, 0.6)); // Nitrogen
             // Paper start - Configurable sprint interruption on attack
             if (!this.level().paperConfig().misc.disableSprintInterruptionOnAttack) {
             this.setSprinting(false);
