From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Biquaternions <biquaternions@serlith.net>
Date: Thu, 13 Aug 2026 16:21:07 -0500
Subject: [PATCH] Restore Self Hit By Arrows

==== WIP ====
This patch restores the possibility of players hitting themselves by arrows.
This enables old mechanics like bow boosting.

==== WIP ====
At the time of writing this, this has successfully re-enabled bow boosting,
  however, it isn't as easy to trigger as it was in 1.8.

diff --git a/net/minecraft/world/entity/projectile/Projectile.java b/net/minecraft/world/entity/projectile/Projectile.java
index 91e2626809be2ea717063517d63e11ed1831b0d6..562e161cc67a8846940445103ae7b6adb3ff7e6c 100644
--- a/net/minecraft/world/entity/projectile/Projectile.java
+++ b/net/minecraft/world/entity/projectile/Projectile.java
@@ -147,6 +147,7 @@ public abstract class Projectile extends Entity implements TraceableEntity {
     }
 
     private boolean isOutsideOwnerCollisionRange() {
+        if (this.getOwner() instanceof Player) return true; // Nitrogen - Restore self hit by arrows
         Entity owner = this.getOwner();
         if (owner != null) {
             AABB aabb = this.getBoundingBox().expandTowards(this.getDeltaMovement()).inflate(1.0);
@@ -159,6 +160,7 @@ public abstract class Projectile extends Entity implements TraceableEntity {
         }
     }
 
+    // Nitrogen - TODO: Check if there's something to port here, see 1.8 EntityArrow#shoot
     public Vec3 getMovementToShoot(final double xd, final double yd, final double zd, final float pow, final float uncertainty) {
         return new Vec3(xd, yd, zd)
             .normalize()
diff --git a/net/minecraft/world/entity/projectile/arrow/AbstractArrow.java b/net/minecraft/world/entity/projectile/arrow/AbstractArrow.java
index d25d525bad6b8096d80da19f3f969c1be514b115..63682bfb7033bdcbe6b09371cde08ab40c99a1e9 100644
--- a/net/minecraft/world/entity/projectile/arrow/AbstractArrow.java
+++ b/net/minecraft/world/entity/projectile/arrow/AbstractArrow.java
@@ -630,6 +630,7 @@ public abstract class AbstractArrow extends Projectile {
     }
 
     protected Collection<EntityHitResult> findHitEntities(final Vec3 from, final Vec3 to) {
+        // Nitrogen - TODO: Check this, setting includeFromEntity to true makes arrows always hit you, maybe this is the time to restore bow boosting behavior
         return ProjectileUtil.getManyEntityHitResult(
             this.level(), this, from, to, this.getBoundingBox().expandTowards(this.getDeltaMovement()).inflate(1.0), this::canHitEntity, false
         );
