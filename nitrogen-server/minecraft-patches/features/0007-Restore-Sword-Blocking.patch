From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Biquaternions <biquaternions@serlith.net>
Date: Wed, 12 Aug 2026 17:08:52 -0500
Subject: [PATCH] Restore Sword Blocking


diff --git a/net/minecraft/world/entity/player/Player.java b/net/minecraft/world/entity/player/Player.java
index 00d73885502e7ca1051733a255b1d9dac2317948..99830f9500e63b1bae397738a7243c5312827d5b 100644
--- a/net/minecraft/world/entity/player/Player.java
+++ b/net/minecraft/world/entity/player/Player.java
@@ -220,7 +220,7 @@ public abstract class Player extends Avatar implements ContainerUser {
         return LivingEntity.createLivingAttributes()
             .add(Attributes.ATTACK_DAMAGE, 1.0)
             .add(Attributes.MOVEMENT_SPEED, 0.1F)
-            .add(Attributes.ATTACK_SPEED)
+            .add(Attributes.ATTACK_SPEED, 1024.0F) // Nitrogen - Disable attack cooldown
             .add(Attributes.LUCK)
             .add(Attributes.BLOCK_INTERACTION_RANGE)
             .add(Attributes.BLOCK_BREAK_SPEED)
